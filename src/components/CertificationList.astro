---
import { certificationSlug, formatDate, type Certification } from "../data/portfolio";

type Props = {
  certifications: Certification[];
};

const { certifications } = Astro.props;
---

<section class="newspaper-section certifications-section" id="certifications">
  <div class="section-heading">
    <p class="kicker">Notices and Credentials</p>
    <h2>Certifications</h2>
    <p>Certificates, organizations, participation, and volunteer work collected as short public notices.</p>
  </div>
  <div class="notice-grid">
    {certifications.map((item) => (
      <article class="notice-card" style={`--accent: ${item.color}`}>
        <div class="notice-stamp">{item.type}</div>
        <h3>{item.name}</h3>
        <p class="notice-meta">{item.issuer} - {formatDate(item.date)}</p>
        <p>{item.details}</p>
        <div class="project-links">
          <a href={`/certifications/${certificationSlug(item)}/`}>Details</a>
          {item.certificate_link && <a href={item.certificate_link} target="_blank" rel="noreferrer">Certificate</a>}
          {item.website_link && <a href={item.website_link} target="_blank" rel="noreferrer">Website</a>}
        </div>
      </article>
    ))}
  </div>
</section>
