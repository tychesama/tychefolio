---
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getTagValue,
  portfolio,
  projectPlaceholder,
  projectSlug,
  type Project,
} from "../../data/portfolio";

export function getStaticPaths() {
  return portfolio.projects.map((project, index) => ({
    params: { slug: projectSlug(project) },
    props: { project, index },
  }));
}

type Props = {
  project: Project;
  index: number;
};

const { project, index } = Astro.props;
const image = projectPlaceholder(index);
const projectType = getTagValue(project, "type");
const platform = getTagValue(project, "platform");
const status = getTagValue(project, "status");
const domains = project.tags
  .filter((tag) => tag.startsWith("domain:"))
  .map((tag) => tag.replace("domain:", ""));
const collaborators = Object.entries(project.collaborators);
---

<BaseLayout title={`${project.name} | Tychefolio`} description={project.description}>
  <div class="page-shell">
    <Header />
    <main>
      <article class="detail-page project-detail" style={`--accent: ${project.color}`}>
        <a class="back-link" href="/#projects">Back to Projects</a>
        <div class="detail-hero">
          <div>
            <p class="kicker">Project Record</p>
            <h1>{project.name}</h1>
            <p class="deck">{project.description}</p>
            <div class="detail-actions">
              <a class="button primary" href={project.link} target="_blank" rel="noreferrer">GitHub</a>
              {project.deployment && <a class="button" href={project.deployment} target="_blank" rel="noreferrer">Live</a>}
              {project.documentation && <a class="button" href={project.documentation} target="_blank" rel="noreferrer">Docs</a>}
            </div>
          </div>
          <img src={image} alt={`Temporary project visual for ${project.name}`} />
        </div>

        <section class="information-panel" aria-label="Project information">
          <h2>Information</h2>
          <dl class="information-list">
            <div>
              <dt>Status</dt>
              <dd>{status || "Portfolio"}</dd>
            </div>
            <div>
              <dt>Type</dt>
              <dd>{projectType || "Project"}</dd>
            </div>
            <div>
              <dt>Platform</dt>
              <dd>{platform || "General"}</dd>
            </div>
            <div>
              <dt>Repository</dt>
              <dd>{project.repo || "Not listed"}</dd>
            </div>
            <div>
              <dt>Owner</dt>
              <dd>{project.user}</dd>
            </div>
            <div>
              <dt>Favorite</dt>
              <dd>{project.favorite ? "Front Page" : "Standard record"}</dd>
            </div>
            <div>
              <dt>Stack</dt>
              <dd>{project.techstack.join(", ")}</dd>
            </div>
            <div>
              <dt>Domains</dt>
              <dd>{domains.length > 0 ? domains.join(", ") : "Portfolio"}</dd>
            </div>
            <div>
              <dt>Collaborators</dt>
              <dd>
                {
                  collaborators.length > 0
                    ? collaborators.map(([name]) => name).join(", ")
                    : "Solo project"
                }
              </dd>
            </div>
          </dl>
          <div class="detail-links">
            <a href={project.link} target="_blank" rel="noreferrer">GitHub</a>
            {project.deployment && <a href={project.deployment} target="_blank" rel="noreferrer">Live Demo</a>}
            {project.documentation && <a href={project.documentation} target="_blank" rel="noreferrer">Documentation</a>}
            {collaborators.map(([name, link]) => (
              <a href={link} target="_blank" rel="noreferrer">{name}</a>
            ))}
          </div>
        </section>
      </article>
    </main>
  </div>
</BaseLayout>
