---
import { experienceSlug, formatDate, type Experience } from "../data/portfolio";

type Props = {
  experience: Experience[];
};

const { experience } = Astro.props;
---

<section class="newspaper-section split-section experience-section" id="experience">
  <div>
    <p class="kicker">Field Report</p>
    <h2>Experience</h2>
  </div>
  <div class="experience-list">
    {experience.map((item) => (
      <article class="experience-card">
        <a class="stretched-link" href={`/experience/${experienceSlug(item)}/`} aria-label={`Read ${item.role} field report`}></a>
        <div class="experience-stamp">
          <span>{formatDate(item.date)}</span>
          <strong>{item.duration}</strong>
        </div>
        <div>
          <h3>{item.role}</h3>
          <a href={item.link} target="_blank" rel="noreferrer">{item.company}</a>
          <p>{item.description}</p>
          <div class="project-links">
            <a href={`/experience/${experienceSlug(item)}/`}>Read Field Report</a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
